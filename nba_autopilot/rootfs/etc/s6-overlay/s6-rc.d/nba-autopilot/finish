#!/command/with-contenv bashio
# ==============================================================================
# NBA Fantasy Autopilot -- finish script
# $1 = exit code of run (or 256 if killed by a signal)
# $2 = signal number, when $1 is 256
# ==============================================================================
declare exit_code_container
declare exit_code_service="${1}"
declare exit_code_signal="${2}"

readonly exit_code_container=$(</run/s6-linux-init-container-results/exitcode)

bashio::log.info \
    "Service nba-autopilot exited with code ${exit_code_service} (by signal ${exit_code_signal})"

if [[ "${exit_code_service}" -eq 256 ]]; then
    # Killed by a signal: preserve any existing container exit code.
    if [[ "${exit_code_container}" -eq 0 ]]; then
        echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exitcode
    fi
    [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
    if [[ "${exit_code_container}" -eq 0 ]]; then
        echo "${exit_code_service}" > /run/s6-linux-init-container-results/exitcode
    fi
    # A crash of the main service should bring the whole app down so the
    # Supervisor surfaces it, rather than silently restarting forever.
    exec /run/s6/basedir/bin/halt
fi
